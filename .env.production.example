NODE_ENV=production
HOST=127.0.0.1
PORT=4400

# HERA habilitado; mantiene revisión y bloqueos de datos pendientes.
ENABLE_HERA=true
ENABLE_LEGACY_EXPORTS=false
ENABLE_FILE_WRITES=true

# En Linux los recursos SMB deben estar montados como rutas POSIX locales.
REVIEW_DIRECTORY=/mnt/toldos/oficina-tecnica/{YYYY}/TOLDOS
PLANTEAMIENTOS_DIRECTORY=/mnt/toldos/oficina-tecnica/{YYYY}/TOLDOS
RPS_UPLOAD_DIRECTORY=/mnt/toldos/rps
RPS_PLANTEAMIENTOS_DIRECTORY=/mnt/rps/ventas/planteamientos/{YYYY}
WORKFLOW_SETTINGS_FILE=/var/lib/toldos-testar/workflow-settings.json
# Parámetros de cálculo comunes a todos los puestos (con su historial al lado).
RULE_PARAMETERS_FILE=/var/lib/toldos-testar/rule-parameters.json

# RPSNext: cuenta de solo lectura.
DB_SERVER=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_DATABASE=RPSNext
DB_COMPANY=001

# CoordinaOT: «Generar archivos» solo genera lo que CoordinaOT ha aprobado y lo pregunta
# a su ruta /api/integracion/ofs. COORDINA_URL es la dirección de CoordinaOT en el
# servidor (p. ej. http://127.0.0.1:4300); COORDINA_CLAVE, la misma clave que INTEGRACION_CLAVE en CoordinaOT.
# Sin las dos no se puede generar ningún pedido.
COORDINA_URL=
COORDINA_CLAVE=

# Web de remolques mientras se une a esta (fase 1). Es la dirección que abre el
# navegador de cada puesto, no la interna del servidor. Ej.: http://192.168.0.90:4500
REMOLQUES_URL=
