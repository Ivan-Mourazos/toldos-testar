NODE_ENV=production
HOST=127.0.0.1
PORT=4400

# No habilitar HERA en producción hasta completar y validar su configuración.
ENABLE_HERA=false
ENABLE_LEGACY_EXPORTS=false
ENABLE_FILE_WRITES=true

# En Linux los recursos SMB deben estar montados como rutas POSIX locales.
REVIEW_DIRECTORY=/mnt/toldos/oficina-tecnica/{YYYY}/TOLDOS
PLANTEAMIENTOS_DIRECTORY=/mnt/toldos/planteamientos/{YYYY}
RPS_UPLOAD_DIRECTORY=/mnt/toldos/rps
WORKFLOW_SETTINGS_FILE=/var/lib/toldos-testar/workflow-settings.json

# RPSNext: cuenta de solo lectura.
DB_SERVER=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_DATABASE=RPSNext
DB_COMPANY=001
