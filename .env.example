# Desarrollo local. Copia este archivo como .env y ajusta solo lo necesario.
HOST=127.0.0.1
PORT=4400

# HERA permanece disponible en desarrollo mientras se completa su configuración.
ENABLE_HERA=true

# Compatibilidad de desarrollo; PM2 mantiene cerradas estas rutas antiguas.
ENABLE_LEGACY_EXPORTS=true

# Mantén las escrituras desactivadas hasta configurar y comprobar las carpetas.
ENABLE_FILE_WRITES=false

# Semillas iniciales del flujo. La configuración guardada desde la web prevalece.
REVIEW_DIRECTORY=
PLANTEAMIENTOS_DIRECTORY=
RPS_UPLOAD_DIRECTORY=
RPS_PLANTEAMIENTOS_DIRECTORY=
# Hoja de taller de remolques (fase 4): las carpetas de la web de remolques (sus RUTA_PLANTEAMIENTOS y
# RUTA_OFICINA_TECNICA). La de oficina técnica lleva {YYYY}: ahí va <año>/PEDIDO.pdf.
REMOLQUES_PLANTEAMIENTOS_DIRECTORY=
REMOLQUES_OFICINA_TECNICA_DIRECTORY=
# Pedidos de remolques guardados (fase 5): carpeta interna del servidor (no la compartida), un JSON por
# pedido. En desarrollo, dentro de tmp/ del repositorio.
REMOLQUES_REVISION_DIRECTORY=
# Borradores de toldos y remolques: carpeta interna del servidor (no la compartida), un JSON por
# pedido a medias. En desarrollo, dentro de tmp/ del repositorio.
DRAFTS_DIRECTORY=
WORKFLOW_SETTINGS_FILE=.toldos-testar-settings.json
# Fichas de cliente de remolques (fase 3). Por defecto, junto a remolques-parameters.json.
# REMOLQUES_CLIENTES_FILE=/var/lib/toldos-testar/remolques-clientes.json

# Flujo legado, disponible solo en desarrollo o pruebas controladas.
EXPORT_DIRECTORY=
ORDER_ARCHIVE_ROOT=

# RPSNext: acceso exclusivamente de lectura para catálogos.
DB_SERVER=192.168.0.124
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_DATABASE=RPSNext
DB_COMPANY=001

# CoordinaOT: «Generar archivos» solo genera lo que CoordinaOT ha aprobado y lo pregunta
# a su ruta /api/integracion/ofs. COORDINA_URL es la dirección de CoordinaOT en el
# servidor (en local, p. ej. http://127.0.0.1:4300); COORDINA_CLAVE, la misma clave que INTEGRACION_CLAVE en CoordinaOT.
# Sin las dos no se puede generar ningún pedido.
COORDINA_URL=
COORDINA_CLAVE=

# Web de remolques mientras se une a esta (fase 1). Es la dirección que abre el
# navegador de cada puesto, no la interna del servidor. Ej.: http://192.168.0.90:4500
REMOLQUES_URL=

# Página de telas del planteamiento en HTML, impresa con el Chromium de la hoja de remolques.
# 0 vuelve a la página de pdfkit sin desplegar (reiniciando con PM2). Por defecto, activa.
TELAS_HTML=1
