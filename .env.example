# Valor inicial. Después se administra desde Configuración dentro de la aplicación.
ENABLE_FILE_WRITES=false

# Carpeta compartida donde se guardan los .xls por OF (para materiales-ot)
EXPORT_DIRECTORY=\\\\servidor\\ruta\\SUBIDA DE MATERIALES

# Carpeta raíz del archivo anual de pedidos (resumen .xlsx y planteamiento .pdf)
ORDER_ARCHIVE_ROOT=\\\\servidor\\ruta\\Oficina Tecnica

# Rutas iniciales del nuevo flujo. {YYYY} se sustituye por el año del pedido.
REVIEW_DIRECTORY=\\\\servidor\\ruta\\Oficina Tecnica\\{YYYY}\\TOLDOS
PLANTEAMIENTOS_DIRECTORY=\\\\servidor\\ruta\\PLANTEAMIENTOS\\{YYYY}

# Opcional: ubicación del JSON interno que conserva la configuración de la interfaz.
WORKFLOW_SETTINGS_FILE=C:\\ToldosTestar\\workflow-settings.json

# Puerto del servidor (por defecto 4300)
PORT=4300

# RPSNext: acceso exclusivamente de lectura para catálogos.
DB_SERVER=192.168.0.124
DB_PORT=1433
DB_USER=lectura
DB_PASSWORD=lectura
DB_DATABASE=RPSNext
DB_COMPANY=001
